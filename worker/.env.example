# INDEPENDENT OMS ONLY. Make a local .env; never commit or share secret values.
SUPABASE_URL=https://tbkytdktututiyeoqkwa.supabase.co
SUPABASE_SERVICE_ROLE_KEY=PASTE_INDEPENDENT_SUPABASE_SERVICE_ROLE_KEY_HERE
# Supabase Dashboard > Authentication > Users > select your authorized OMS user > UID
PJS_OFFICE_OWNER_USER_ID=PASTE_YOUR_OMS_USER_UUID_HERE
PJS_WORKER_NAME=pjs-datadoc-office
PJS_POLL_SECONDS=15
# SAFETY: leave 0 until you finish a manual end-to-end acceptance test.
PJS_ENABLE_LIVE_DATADOC=0

# Office-only DataDoc connection; reachable from your Windows PC on office network.
PJS_DATADOC_URL=http://192.168.0.18:8082
PJS_DATADOC_USERNAME=ENTER_ACCOUNT_LOCALLY
PJS_DATADOC_PASSWORD=ENTER_PASSWORD_LOCALLY
PJS_DATADOC_HEADLESS=0
PJS_PAGELOAD_TIMEOUT=35
# Optional dedicated browser profile:
# PJS_DATADOC_CHROME_PROFILE=C:\PJS\DataDocChrome

# Separate adapters translated from VBA. Leave disabled until office acceptance tests.
PJS_ENABLE_LIVE_DATADOC_EMAIL=0
# Authorized Classic Outlook dispatch account; set locally, not in GitHub.
PJS_OUTLOOK_ACCOUNT_SMTP=
PJS_DATADOC_EMAIL_NEXT_USER=Vivek Pal
PJS_HEADLESS=0

# Outlook Reply All draft worker (separate from DataDoc). Default OFF.
PJS_OUTLOOK_WORKER_NAME=pjs-outlook-draft-office
PJS_OUTLOOK_POLL_SECONDS=20
PJS_ENABLE_OUTLOOK_DRAFT=0

# Dispatch Tracking (six read-only carrier lookups; OFF until one-office-PC acceptance).
PJS_TRACKING_WORKER_NAME=pjs-carrier-tracking-office
PJS_TRACKING_POLL_SECONDS=20
PJS_ENABLE_LIVE_TRACKING=0
# Up to 20 Shree Maruti / ARHAM tracking IDs in a single approved browser search.
PJS_SHREE_MARUTI_BATCH_SIZE=20
# Optional: override Python executable for START_OFFICE_WORKERS.ps1 with PJS_PYTHON_EXE.

# DataDoc Tracking Proof screenshot submission; separate worker, disabled by default.
PJS_ENABLE_LIVE_DATADOC_PROOF=0
PJS_PROOF_POLL_SECONDS=20
